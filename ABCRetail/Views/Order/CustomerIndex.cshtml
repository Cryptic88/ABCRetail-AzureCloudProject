@model IEnumerable<ABCRetail.Models.Order>
@{
    ViewData["Title"] = "My Orders";
    var products = ViewBag.Products as Dictionary<string, string>;
}

<div class="container my-4">

    <h2 class="fw-bold display-6 mb-4 text-primary">My Orders</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4 text-center">
            You have no orders yet.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded-4">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>Order ID</th>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Status</th>
                        <th>Order Date</th>
                        <th>Estimated Delivery</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@order.Order_ID</td>
                            <td>@(products.ContainsKey(order.Product_ID) ? products[order.Product_ID] : order.Product_ID)</td>
                            <td>@order.Quantity</td>
                            <td>
                                @switch (order.Status)
                                {
                                    case "Pending":
                                        <span class="badge bg-warning text-dark">@order.Status</span>
                                        break;
                                    case "Packaged":
                                        <span class="badge bg-primary">@order.Status</span>
                                        break;
                                    case "Out for Delivery":
                                        <span class="badge bg-info text-dark">@order.Status</span>
                                        break;
                                    case "Completed":
                                        <span class="badge bg-success">@order.Status</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@order.Status</span>
                                        break;
                                }
                            </td>
                            <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@order.OrderDate.AddDays(10).ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>


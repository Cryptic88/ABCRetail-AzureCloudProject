@model IEnumerable<ABCRetail.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="container my-4">

    <!-- Header + Add Customer Button with a search bar to help users find certian customers easier-->
    <div class="p-4 mb-4 bg-light rounded-4 shadow-sm">
            <h2 class="fw-bold display-6 mb-2">Customers</h2>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mb-3">
            <div class="d-flex flex-column flex-md-row gap-2 w-100 w-md-auto">

                <form asp-action="Index" method="get" class="d-flex gap-2 flex-grow-1 flex-md-auto">
                    <input type="text" name="searchString" class="form-control shadow-sm" style="height: 50px; border-radius: 50px;"
                           value="@ViewBag.SearchString" placeholder="Search by full name" />
                    <button type="submit" class="btn btn-primary shadow-sm search-btn rounded-pill w-80">
                        <i class="bi bi-search me-2"></i> Search
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
                    {
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary shadow-sm d-flex justify-content-center align-items-center"
                           style="height: 50px; border-radius: 50px;">
                            <i class="bi bi-x-circle me-2"></i> Clear
                        </a>
                    }
                </form>
                <a asp-action="AddCustomer" class="btn btn-success shadow-sm add-product-btn btn-lg">
                    <i class="bi bi-person-plus"></i> Add New Customer
                </a>

            </div>
        </div>
    </div>

    <!-- Customer Cards -->
    <!-- (W3shcools, 2019) -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var customer in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body text-center">
                        <i class="bi bi-person-circle display-4 text-primary mb-3"></i>
                        <h5 class="card-title fw-bold">@customer.Customer_Name</h5>
                        <p class="card-text text-muted mb-1"><strong>ID:</strong> @customer.Customer_Id</p>
                        <p class="card-text text-muted mb-1"><strong>Email:</strong> @customer.email</p>
                        <p class="card-text text-muted"><strong>Created:</strong> @customer.Timestamp?.ToLocalTime().ToString("g")</p>
                    </div>

                    <div class="d-flex justify-content-center gap-2 p-3 border-top">
                        <a asp-action="Edit" asp-route-partitionKey="@customer.PartitionKey" asp-route-rowKey="@customer.RowKey" class="btn btn-sm btn-primary shadow-sm">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="Details" asp-route-partitionKey="@customer.PartitionKey" asp-route-rowKey="@customer.RowKey" class="btn btn-sm btn-info shadow-sm">
                            <i class="bi bi-eye"></i> Details
                        </a>
                        <form asp-action="DeleteCustomer" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this customer?');">
                            <input type="hidden" name="partitionKey" value="@customer.PartitionKey" />
                            <input type="hidden" name="rowKey" value="@customer.RowKey" />
                            <button type="submit" class="btn btn-sm btn-danger shadow-sm">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


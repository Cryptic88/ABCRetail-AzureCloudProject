@model ABCRetail.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container my-4">
    <div class="p-4 bg-light rounded-4 shadow-sm">
        <h2 class="fw-bold display-6 mb-3">Edit Product</h2>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Product_ID" />
            <input type="hidden" asp-for="PartitionKey" />
            <input type="hidden" asp-for="RowKey" />
            <input type="hidden" asp-for="ImageURL" />

            <div class="mb-3">
                <label asp-for="Product_Name" class="form-label fw-bold"></label>
                <input asp-for="Product_Name" class="form-control" />
                <span asp-validation-for="Product_Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label fw-bold"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Current Image</label><br />
                @if (!string.IsNullOrEmpty(Model.ImageURL))
                {
                    <img src="@Model.ImageURL" alt="Product Image" width="150" class="rounded mb-2" />
                }
                else
                {
                    <p class="text-muted">No image uploaded</p>
                }
            </div>

            <div class="mb-3">
                <label for="file" class="form-label fw-bold">Upload New Image</label>
                <input type="file" name="file" class="form-control" />
            </div>

            <button type="submit" class="btn btn-success">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
@model IEnumerable<ABCRetail.Models.Order>
@{
    ViewData["Title"] = "My Orders";
    var products = ViewBag.Products as Dictionary<string, string>;
}

<div class="container my-4">
    <h2 class="fw-bold display-6 mb-4">My Orders</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Order ID</th>
                <th>Product</th>
                <th>Quantity</th>
                <th>Status</th>
                <th>Order Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Order_ID</td>
                    <td>@(products.ContainsKey(order.Product_ID) ? products[order.Product_ID] : order.Product_ID)</td>
                    <td>@order.Quantity</td>
                    <td>@order.Status</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>



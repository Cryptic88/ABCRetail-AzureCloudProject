@model IEnumerable<ABCRetail.Models.Product>

@{
    ViewData["Title"] = "Products";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container my-4">

    <div class="p-4 mb-4 bg-light rounded-4 shadow-sm">
        <h2 class="fw-bold display-6 mb-3">Products</h2>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <!-- Search Form -->
            <div class="d-flex flex-grow-1 gap-2 flex-column flex-md-row">
                <form asp-action="Index" method="get" class="d-flex gap-2 flex-grow-1 flex-md-auto">
                    <input type="text" name="searchString" class="form-control shadow-sm" style="height: 50px; border-radius: 50px;"
                           value="@ViewBag.SearchString" placeholder="Search by name" />
                    <button type="submit" class="btn btn-primary shadow-sm rounded-pill px-3">
                        <i class="bi bi-search me-2"></i> Search
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
                    {
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary shadow-sm d-flex justify-content-center align-items-center rounded-pill"
                           style="height: 50px; padding: 0 1rem;">
                            <i class="bi bi-x-circle me-2"></i> Clear
                        </a>
                    }
                </form>

                <a asp-controller="Cart" asp-action="Index"
                   class="btn btn-warning btn-lg shadow-sm d-flex align-items-center gap-2 rounded-pill mt-2 mt-md-0 text-white">
                    <i class="bi bi-cart fs-5 text-white"></i> View Cart
                </a>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    @if (!string.IsNullOrEmpty(product.ImageURL))
                    {
                        <img src="@product.ImageURL" class="card-img-top rounded-top" alt="@product.Product_Name"
                             style="height: 220px; object-fit: cover;">
                    }

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@product.Product_Name</h5>
                        <p class="card-text text-muted mb-2">@product.Description</p>
                        <p class="card-text fw-semibold fs-5">R @product.Price</p>

                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-2 w-100">
                            <input type="hidden" name="productId" value="@product.Product_ID" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-outline-primary w-100">
                                <i class="bi bi-cart-plus me-2"></i> Add to Cart
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

@model List<ABCRetail.Models.CartItem>

<h2 class="mb-4">Shopping Cart</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        Your cart is empty.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@(item.Product?.ImageURL ?? "/images/placeholder.jpg")"
                                 alt="@item.Product?.Product_Name"
                                 style="height:60px; width:60px; object-fit:cover;" />
                        </td>
                        <td>@item.Product?.Product_Name</td>
                        <td>R @item.Product?.Price</td>
                        <td>@item.Quantity</td>
                        <td>R@((item.Product?.Price ?? 0) * item.Quantity)</td>
                        <td class="text-center">
                            <form asp-action="Remove" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="@item.Product.Product_ID" />
                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-action="Clear" class="btn btn-warning">Clear Cart</a>

        <form asp-controller="Order" asp-action="PlaceOrderFromCartConfirmed" method="post" class="d-inline">
            <button type="submit" class="btn btn-success">Place Order</button>
        </form>

    </div>

}
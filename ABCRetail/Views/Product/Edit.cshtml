@model ABCRetail.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="page-bg d-flex align-items-center min-vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">

                <div class="card shadow-lg rounded-4 p-4" style="background-color: rgba(255,255,255,0.95);">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold"><i class="bi bi-box-seam text-success"></i> Edit Product</h2>
                        <p class="text-muted">Update product details and upload a new image if needed.</p>
                    </div>

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Product_ID" />
                        <input type="hidden" asp-for="PartitionKey" />
                        <input type="hidden" asp-for="RowKey" />
                        <input type="hidden" asp-for="ImageURL" />

                        <div class="mb-3">
                            <label asp-for="Product_Name" class="form-label fw-semibold"></label>
                            <input asp-for="Product_Name" class="form-control" placeholder="Enter product name" />
                            <span asp-validation-for="Product_Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" placeholder="Enter product description"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="Enter price" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Current Image</label><br />
                            @if (!string.IsNullOrEmpty(Model.ImageURL))
                            {
                                <img src="@Model.ImageURL" alt="Product Image" width="180" class="rounded shadow-sm mb-2" />
                            }
                            else
                            {
                                <p class="text-muted">No image uploaded</p>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="file" class="form-label fw-semibold">Upload New Image</label>
                            <input type="file" name="file" class="form-control" />
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary me-2">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>

                </div>

            </div>
        </div>
    </div>
</div>
@model ABCRetail.Models.Customer

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-4 p-4">
        <h2 class="fw-bold mb-4 text-center">Add New Customer</h2>

        <form asp-action="AddCustomer" method="post">
            <div class="form-floating mb-3">
                <input asp-for="Customer_Name" class="form-control rounded-3 shadow-sm" placeholder="Name" />
                <label asp-for="Customer_Name">Full Name</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="email" type="email" class="form-control rounded-3 shadow-sm" placeholder="Email" />
                <label asp-for="email">Email Address</label>
            </div>

            <div class="form-group mb-3">
                <label asp-for="password" class="form-label"></label>
                <input asp-for="password" type="password" class="form-control" required />
                <span asp-validation-for="password" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <button type="submit" class="btn btn-primary btn-lg px-4 shadow-sm">
                    <i class="bi bi-person-plus"></i> Add Customer
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 shadow-sm">
                    <i class="bi bi-arrow-left-circle"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>
@model IEnumerable<ABCRetail.Models.Product>

@{
    ViewData["Title"] = "Products";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container my-4">

    <div class="p-4 mb-4 bg-light rounded-4 shadow-sm">
        <h2 class="fw-bold display-6 mb-2">Products</h2>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mb-3">
            <div class="d-flex flex-column flex-md-row gap-2 w-100 w-md-auto">
                <!-- Search Form -->
                <form asp-action="Index" method="get" class="d-flex gap-2 flex-grow-1 flex-md-auto">
                    <input type="text" name="searchString" class="form-control shadow-sm" style="height: 50px; border-radius: 50px;"
                           value="@ViewBag.SearchString" placeholder="Search by name or location" />
                    <button type="submit" class="btn btn-primary shadow-sm search-btn rounded-pill w-80">
                        <i class="bi bi-search me-2"></i> Search
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
                    {
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary shadow-sm" style="height: 50px; border-radius: 50px;">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    }
                </form>

                <!-- Add Product Button -->
                <a asp-action="AddProduct" class="btn btn-success shadow-sm add-product-btn btn-lg">
                    <i class="bi bi-plus-circle me-2"></i> Add New Product
                </a>
            </div>
        </div>
    </div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(product.ImageURL))
                {
                    <img src="@product.ImageURL" class="card-img-top" alt="@product.Product_Name"
                         style="height: 200px; object-fit: cover;">
                }

                <div class="card-body">
                    <h5 class="card-title">@product.Product_Name</h5>
                    <p class="card-text"><strong>ID:</strong> @product.Product_ID</p>
                    <p class="card-text"><strong>Description:</strong> @product.Description</p>
                    <p class="card-text"><strong>Location:</strong> @product.Location</p>
                </div>

                <div class="btn-group p-2" role="group">
                    <a asp-action="Edit" asp-route-id="@product.Product_ID" class="btn btn-sm btn-primary" title="Edit">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-action="Details" asp-route-id="@product.Product_ID" class="btn btn-sm btn-info" title="Details">
                        <i class="bi bi-eye"></i> Details
                    </a>
                    <a asp-action="Delete" asp-route-id="@product.Product_ID"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Are you sure you want to delete this prodduct?')">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    }
</div>

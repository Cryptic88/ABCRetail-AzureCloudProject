@model ABCRetail.Models.CustomerSql

@{
    ViewData["Title"] = "My Account";
}

<div class="container my-4">
    <h2 class="fw-bold display-6 mb-4">My Account</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body text-center">
            <i class="bi bi-person-circle display-4 text-primary mb-3"></i>
            <h5 class="card-title fw-bold">@Model.Name</h5>
            <p class="card-text text-muted mb-1"><strong>ID:</strong> @Model.CustomerId</p>
            <p class="card-text text-muted mb-1"><strong>Email:</strong> @Model.Email</p>
        </div>

        <div class="d-flex justify-content-center gap-2 p-3 border-top">
            <a asp-action="CustomerEdit" class="btn btn-sm btn-primary shadow-sm">
                <i class="bi bi-pencil"></i> Edit My Details
            </a>
        </div>
    </div>
</div>


@model IEnumerable<ABCRetail.Models.Order>
@{
    ViewData["Title"] = "Orders";
    var customers = ViewBag.Customers as Dictionary<string, string>;
    var products = ViewBag.Products as Dictionary<string, string>;
}

<div class="container my-4">
    <h2 class="fw-bold display-6 mb-4">Orders</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <a asp-action="PlaceOrder" class="btn btn-success mb-3">
        <i class="bi bi-plus-circle"></i> Place New Order
    </a>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Product</th>
                <th>Quantity</th>
                <th>Status</th>
                <th>Order Date</th>
                <th>Process</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Order_ID</td>
                    <td>@(customers.ContainsKey(order.Customer_Id) ? customers[order.Customer_Id] : order.Customer_Id)</td>
                    <td>@(products.ContainsKey(order.Product_ID) ? products[order.Product_ID] : order.Product_ID)</td>
                    <td>@order.Quantity</td>
                    <td>
                        @switch (order.Status)
                        {
                            case "Pending":
                                <span class="badge bg-warning text-dark">@order.Status</span>
                                break;
                            case "Processed":
                                <span class="badge bg-info text-dark">@order.Status</span>
                                break;
                            case "Completed":
                                <span class="badge bg-success">@order.Status</span>
                                break;
                            default:
                                <span class="badge bg-secondary">@order.Status</span>
                                break;
                        }
                    </td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (order.Status == "Pending")
                        {
                            <form asp-action="ProcessOrder" method="post" class="d-inline">
                                <input type="hidden" name="orderId" value="@order.Order_ID" />
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="bi bi-check-circle"></i> Process
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        <form asp-action="CancelOrder" method="post" style="display:inline">
                            <input type="hidden" name="partitionKey" value="@order.PartitionKey" />
                            <input type="hidden" name="rowKey" value="@order.RowKey" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="bi bi-x-circle"></i> Cancel
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


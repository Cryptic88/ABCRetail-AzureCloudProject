@model ABCRetail.Models.CustomerSql

@{
    ViewData["Title"] = "My Account";
}

<div class="container my-4">

    <h2 class="fw-bold display-6 mb-4 text-primary">My Account</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 p-4 text-center text-dark"
         style="background: linear-gradient(rgba(0, 102, 255, 0.1), rgba(0, 153, 255, 0.1));">
        <div class="card-body">
            <i class="bi bi-person-circle display-3 mb-3 text-primary"></i>
            <h5 class="card-title fw-bold">@Model.Name</h5>
            <p class="card-text mb-1"><strong>ID:</strong> @Model.CustomerId</p>
            <p class="card-text mb-1"><strong>Email:</strong> @Model.Email</p>
        </div>

        <div class="d-flex justify-content-center gap-2 mt-3 pt-2 border-top">
            <a asp-action="CustomerEdit" class="btn btn-primary btn-md shadow-sm">
                <i class="bi bi-pencil me-2"></i> Edit My Details
            </a>
        </div>
    </div>
</div>


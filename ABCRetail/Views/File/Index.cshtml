@model List<ABCRetail.Models.FileModel>

<h2 class="fw-bold display-6 mb-4">Contracts</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<!-- (W3shcools, 2019) -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">Upload New Contract</h5>
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-3">
            <div class="col-md-8">
                <input type="file" name="file" class="form-control" />
            </div>
            <div class="col-md-4 d-grid">
                <button type="submit" class="btn btn-primary">Upload</button>
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Count > 0)
{
    <!-- (W3shcools, 2019) -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Available Contracts</h5>
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Size</th>
                        <th scope="col">Last Modified</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contract in Model)
                    {
                        <tr>
                            <td>@contract.Name</td>
                            <td>@string.Format("{0:N0}", contract.Size) bytes</td>
                            <td>@contract.LastModified?.ToString("g")</td>
                            <td>
                                <a asp-action="DownloadFile" asp-route-fileName="@contract.Name" class="btn btn-sm btn-success">
                                    Download
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">No contracts found.</div>
}

@model IEnumerable<ABCRetail.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<h2 class="mb-4">Customers</h2>

<p>
    <a asp-action="AddCustomer" class="btn btn-success mb-4">
        <i class="bi bi-person-plus"></i> Add New Customer
    </a>
</p>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var customer in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-person-circle display-4 text-secondary mb-3"></i>
                    <h5 class="card-title">@customer.Customer_Name</h5>
                    <p class="card-text"><strong>ID:</strong> @customer.Customer_Id</p>
                    <p class="card-text"><strong>Email:</strong> @customer.email</p>
                    <p class="card-text"><strong>Created:</strong> @customer.Timestamp</p>
                </div>

                <div class="btn-group p-2" role="group">
                    <a asp-action="Edit" asp-route-id="@customer.Customer_Id"
                       class="btn btn-sm btn-primary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-action="Details" asp-route-id="@customer.Customer_Id"
                       class="btn btn-sm btn-info">
                        <i class="bi bi-eye"></i> Details
                    </a>
                    <a asp-action="Delete" asp-route-id="@customer.Customer_Id"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Are you sure you want to delete this customer?')">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    }
</div>

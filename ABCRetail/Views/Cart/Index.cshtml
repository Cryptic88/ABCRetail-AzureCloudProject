@model List<ABCRetail.Models.CartItem>

@{
    decimal grandTotal = 0;
    if (Model != null)
    {
        grandTotal = Model.Sum(item => (item.Product?.Price ?? 0) * item.Quantity);
    }
}

<div class="cart-page container py-4">

    <h2 class="mb-4 text-primary fw-bold">Shopping Cart</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            Your cart is empty.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded-3 mb-3">
            <table class="table table-hover align-middle text-center mb-0">
                <thead class="table-primary">
                    <tr>
                        <th scope="col">Image</th>
                        <th scope="col">Product Name</th>
                        <th scope="col">Price (Each)</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Total</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(item.Product?.ImageURL ?? "/images/placeholder.jpg")"
                                     alt="@item.Product?.Product_Name"
                                     class="img-thumbnail"
                                     style="height:60px; width:60px; object-fit:cover;" />
                            </td>
                            <td class="text-start">@item.Product?.Product_Name</td>
                            <td>R @(item.Product?.Price)</td>
                            <td>@item.Quantity</td>
                            <td class="fw-bold">R @(((item.Product?.Price ?? 0) * item.Quantity).ToString("N2"))</td>
                            <td>
                                <form asp-action="Remove" method="post" class="d-inline">
                                    <input type="hidden" name="productId" value="@item.Product.Product_ID" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Grand Total Box -->
        <div class="text-end mb-4">
            <span class="fw-bold fs-3">Grand Total: R @(grandTotal.ToString("N2"))</span>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <a asp-action="Clear" class="btn btn-outline-warning fw-semibold">
                <i class="bi bi-x-circle"></i> Clear Cart
            </a>

            <form asp-controller="Order" asp-action="PlaceOrderFromCartConfirmed" method="post" class="d-inline">
                <button type="submit" class="btn btn-primary fw-bold">
                    <i class="bi bi-bag-check"></i> Place Order
                </button>
            </form>
        </div>
    }
</div>
